<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FileSearcherApp"
        x:Class="FileSearcherApp.MainWindow"
        Title="Dateisuche über Powershell"
        MinWidth="650"
        MinHeight="450"
        Width="650"
        Height="450"
        Icon="avares://FileSearcherApp/GUIAssets/icon.png"
        Background="#0c3835">

    <Window.Styles>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#001816"/>
            <Setter Property="Foreground" Value="#C9DDDC"/>
            <Setter Property="BorderBrush" Value="#3F6B68"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="FlyoutPresenter.file-type-filter">
            <Setter Property="Background" Value="#0c3835"/>
            <Setter Property="Foreground" Value="#C9DDDC"/>
            <Setter Property="BorderBrush" Value="#3F6B68"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto">

        <Grid Grid.Row="0" Margin="20" RowDefinitions="Auto,Auto,Auto,*">

            <!-- Überschrift & Zähler -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  Margin="0,0,0,10">
                <TextBlock Grid.Column="0"
                           x:Name="WelcomeText"
                           Text="Hallo!"
                           Foreground="#8AABAA"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <TextBlock Grid.Column="1"
                           x:Name="ResultsCountText"
                           Text="Dateien gefunden: 0"
                           Foreground="#8AABAA"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>

            <!-- Suchfeld und Buttons -->
            <Grid Grid.Row="1"
                  ColumnDefinitions="*,Auto,Auto"
                  Margin="0,0,0,10">

                <Border Grid.Column="0"
                        CornerRadius="8"
                        Background="#001816"
                        Margin="0,0,10,0">
                    <TextBox x:Name="SearchBox"
                             Watermark="Suchbegriff eingeben..."
                             Background="Transparent"
                             BorderBrush="Transparent"
                             Foreground="#C9DDDC"
                             CaretBrush="#C9DDDC"
                             FontSize="16"
                             Margin="4"/>
                </Border>

                <!-- Filterbutton -->
                <Button Grid.Column="1"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="#001816"
                        Foreground="#8AABAA"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Margin="0,0,5,0"
                        ToolTip.Tip="Suchfilter"
                        AutomationProperties.Name="Suchfilter">
                    <PathIcon Width="20" Height="20" Foreground="#8AABAA"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M2,5 H13 V7 H2 Z M16,5 H22 V7 H16 Z M13,3 H16 V9 H13 Z M2,11 H7 V13 H2 Z M10,11 H22 V13 H10 Z M7,9 H10 V15 H7 Z M2,17 H15 V19 H2 Z M18,17 H22 V19 H18 Z M15,15 H18 V21 H15 Z"/>
                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="file-type-filter" Opened="OnFilterFlyoutOpened">
                            <StackPanel Width="280" Spacing="8">
                                <StackPanel.Resources>
                                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#164845"/>
                                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#082624"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#C9DDDC"/>
                                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#C9DDDC"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3F6B68"/>
                                    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#8AABAA"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#164845"/>
                                    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#082624"/>
                                    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#082624"/>
                                    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3F6B68"/>
                                    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForeground" Color="#8AABAA"/>
                                    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#164845"/>
                                    <SolidColorBrush x:Key="ComboBoxItemForegroundPointerOver" Color="#C9DDDC"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#082624"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#001816"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#8AABAA"/>
                                    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#C9DDDC"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8AABAA"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8AABAA"/>
                                    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8AABAA"/>
                                </StackPanel.Resources>
                                <StackPanel.Styles>
                                    <Style Selector="Button">
                                        <Setter Property="Background" Value="#001816"/>
                                        <Setter Property="Foreground" Value="#C9DDDC"/>
                                        <Setter Property="BorderBrush" Value="#3F6B68"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                    <Style Selector="TextBox, ComboBox">
                                        <Setter Property="Background" Value="#001816"/>
                                        <Setter Property="Foreground" Value="#C9DDDC"/>
                                        <Setter Property="BorderBrush" Value="#3F6B68"/>
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                    <Style Selector="ComboBoxItem">
                                        <Setter Property="Foreground" Value="#C9DDDC"/>
                                    </Style>
                                </StackPanel.Styles>
                                <TextBlock Text="Dateitypen" FontWeight="Bold"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <TextBox x:Name="FileTypeBox"
                                             Watermark="z. B. pdf, docx"
                                             CaretBrush="#C9DDDC"
                                             AutomationProperties.Name="Dateiendungen"
                                             KeyDown="OnFileTypeKeyDown"/>
                                    <Button Grid.Column="1" Content="Hinzufügen" Click="OnAddFileTypesClick"
                                            VerticalAlignment="Stretch"/>
                                </Grid>
                                <TextBlock x:Name="FileTypeErrorText" IsVisible="False" TextWrapping="Wrap"/>
                                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="FileTypeList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Text="{Binding .}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <Button Grid.Column="1" Click="OnRemoveFileTypeClick"
                                                            Width="32" Height="32" Padding="0"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center"
                                                            ToolTip.Tip="Dateityp entfernen"
                                                            AutomationProperties.Name="{Binding ., StringFormat='Dateityp {0} entfernen'}">
                                                        <PathIcon Width="14" Height="14" Foreground="#8AABAA"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  Data="M9,3 H15 V5 H20 V7 H4 V5 H9 Z M6,9 H18 L17,21 H7 Z"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0"
                                          AutomationProperties.Name="Suchbereich"
                                          SelectionChanged="OnSearchModeChanged">
                                    <ComboBoxItem Content="Nach Name" Tag="FileName"/>
                                    <ComboBoxItem Content="Nach Inhalt" Tag="Content"/>
                                    <ComboBoxItem Content="Nach Name und Inhalt" Tag="Both"/>
                                </ComboBox>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Einstellungsbutton -->
                <Button Grid.Column="2"
                        Width="40"
                        Height="40"
                        CornerRadius="20"
                        Background="#001816"
                        Foreground="#8AABAA"
                        Padding="0"
                        ToolTip.Tip="Einstellungen">
                    <Image Source="avares://FileSearcherApp/GUIAssets/settingsIcon.png"
                           Width="20"
                           Height="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Gestalten"/>
                            <MenuItem Header="filler"/>
                            <MenuItem Header="Die Gui ist schuld"/>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- Tabellenkopf -->
            <Border Grid.Row="2"
                    BorderBrush="#408AABAA"
                    BorderThickness="0,0,0,1"
                    Padding="12,6,28,6">
                <Grid ColumnDefinitions="2*,60,130,3*" ColumnSpacing="12">
                    <TextBlock Grid.Column="0" Text="Datei"    FontWeight="Bold" Foreground="#8AABAA"/>
                    <TextBlock Grid.Column="1" Text="Typ"      FontWeight="Bold" Foreground="#8AABAA"/>
                    <TextBlock Grid.Column="2" Text="Geändert" FontWeight="Bold" Foreground="#8AABAA"/>
                    <TextBlock Grid.Column="3" Text="Pfad"     FontWeight="Bold" Foreground="#8AABAA"/>
                </Grid>
            </Border>

            <!-- Ergebnisliste -->
            <ListBox Grid.Row="3"
                     x:Name="ResultsList"
                     HorizontalAlignment="Stretch"
                     VerticalAlignment="Stretch"
                     Background="#001816"
                     Foreground="#8AABAA"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.DataTemplates>
                    <DataTemplate x:DataType="local:SearchHit">
                        <Border Background="Transparent"
                                HorizontalAlignment="Stretch"
                                Padding="12,9"
                                Tapped="OnSearchHitTapped"
                                Cursor="Hand"
                                ToolTip.ShowDelay="400"
                                ToolTip.Placement="Right">
                            <ToolTip.Tip>
                                <StackPanel Spacing="6" MaxWidth="480">
                                    <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                    <Separator/>

                                    <!-- Vorschaubild (nur bei Bilddateien sichtbar) -->
                                    <Image Source="{Binding Path, Converter={x:Static local:ThumbnailConverter.Instance}}"
                                           IsVisible="{Binding $self.Source, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           MaxWidth="320"
                                           MaxHeight="200"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Left"/>

                                    <TextBlock Inlines="{Binding Preview, Converter={x:Static local:HighlightConverter.Instance}}"
                                               IsVisible="{Binding Path, Converter={x:Static local:FileTypeConverters.IsNotImage}}"
                                               TextWrapping="Wrap"
                                               MaxHeight="220"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Separator/>
                                    <TextBlock Text="{Binding Path}" Opacity="0.7" TextWrapping="Wrap" FontSize="11"/>
                                    <TextBlock Text="{Binding LastWriteText}" Opacity="0.7" FontSize="11"/>
                                </StackPanel>
                            </ToolTip.Tip>

                            <Grid ColumnDefinitions="2*,60,130,3*" ColumnSpacing="12">
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding Extension}" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding LastWriteText}" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="3" Text="{Binding Path}" Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="1" Background="#082624" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="ScanStatusText"
                           Grid.Column="0"
                           Text="Bereit"
                           Foreground="#80A09F"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,12,0"/>
                <ProgressBar x:Name="ScanProgressBar"
                             Grid.Column="1"
                             Width="150"
                             Height="6"
                             IsVisible="False"
                             IsIndeterminate="False"
                             Foreground="#80A09F"
                             Background="#0c3835"
                             VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </Grid>
</Window>