
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FileSearcherApp"
        x:Class="FileSearcherApp.MainWindow"
        Title="Dateisuche über Powershell"
        Width="650"
        Height="450"
        Icon="avares://FileSearcherApp/GUIAssets/logo.png"
        FontFamily="Consolas"
        Background="#0c3835">

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Menü -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Menu DockPanel.Dock="Right">
                <MenuItem Header="_Sortieren">
                    <MenuItem Header="_Aufsteigend"/>
                    <MenuItem Header="_Absteigend"/>
                </MenuItem>
            </Menu>

            <Menu DockPanel.Dock="Left">
                <MenuItem Header="_Filter">
                    <MenuItem Header="_Nach Name"/>
                    <MenuItem Header="_Nach Endung"/>
                    <MenuItem Header="_Nach Datum"/>
                </MenuItem>
            </Menu>
        </DockPanel>

        <!-- Überschrift -->
        <TextBlock Grid.Row="1"
                   Text="Powershell Suchmaschine"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="White"
                   Margin="0,0,0,10"/>

        <!-- Suchfeld und Dateianzeige -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,*"
              
              Margin="0,0,0,10">

            <Border Grid.Column="0"
                    CornerRadius="8"
                    Background="#001816">
                <TextBox x:Name="SearchBox"
                         Watermark="Suchbegriff eingeben..."
                         Background="Transparent"
                         BorderBrush="Transparent"
                         FontSize="16"
                         Margin="4"/>
            </Border>

            <Border Grid.Column="1"
                    CornerRadius="8"
                    Background="#001816">
                <TextBlock Text="Dateien Gefunden:"
                           Foreground="#606e6d"
                           FontSize="16"
                           Margin="4"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Suchbutton -->
        <Button Grid.Row="3"
                Content="Suche starten"
                Click="OnSearchClicked"
                Foreground="#606e6d"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Margin="0,0,0,10"/>

        <!-- Ergebnisliste mit Dateivorschau -->
        <ListBox Grid.Row="4"
                 x:Name="ResultsList"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Background="#001816"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.Styles>

            <ListBox.DataTemplates>
                <DataTemplate DataType="local:SearchHit">

                    <Border Background="Transparent"
                            HorizontalAlignment="Stretch"
                            Padding="12,9"
                            ToolTip.ShowDelay="400"
                            ToolTip.Placement="Right">

                        <ToolTip.Tip>
                            <StackPanel Spacing="6" MaxWidth="480">

                                <TextBlock Text="{Binding FileName}"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Path}"
                                           Opacity="0.7"
                                           TextWrapping="Wrap"
                                           FontSize="11"/>

                                <TextBlock Text="{Binding LastWriteText}"
                                           Opacity="0.7"
                                           FontSize="11"/>

                                <Separator/>

                                <TextBlock Inlines="{Binding Preview, Converter={x:Static local:HighlightConverter.Instance}}"
                                           TextWrapping="Wrap"
                                           MaxHeight="220"
                                           TextTrimming="CharacterEllipsis"/>

                            </StackPanel>
                        </ToolTip.Tip>

                        <TextBlock Text="{Binding}"
                                   TextTrimming="CharacterEllipsis"/>

                    </Border>

                </DataTemplate>
            </ListBox.DataTemplates>

        </ListBox>

    </Grid>
</Window>
