<Window xmlns="https://github.com/avaloniaui"
        MinWidth="650"
        MinHeight="450"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:FileSearcherApp"
        x:Class="FileSearcherApp.MainWindow"
        Title="Dateisuche über Powershell"
        Width="650"
        Height="450"
        Icon="avares://FileSearcherApp/GUIAssets/icon.png"
        Background="#0c3835">

    <Grid Margin="20" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <!-- Überschrift & Zähler -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,10">
            <TextBlock Grid.Column="0"
                       x:Name="WelcomeText"
                       Text="Hallo!"
                       Foreground="#8AABAA"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

            <TextBlock Grid.Column="1"
                       x:Name="ResultsCountText"
                       Text="Dateien gefunden: 0"
                       Foreground="#8AABAA"
                       FontSize="18"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"/>
        </Grid>

        <!-- Suchfeld und Buttons -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,0,0,10">

            <Border Grid.Column="0"
                    CornerRadius="8"
                    Background="#001816"
                    Margin="0,0,10,0">
                <TextBox x:Name="SearchBox"
                         Watermark="Suchbegriff eingeben..."
                         Background="Transparent"
                         BorderBrush="Transparent"
                         FontSize="16"
                         Margin="4"/>
            </Border>

            <!-- Filterbutton -->
            <Button Grid.Column="1"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="#001816"
                    Foreground="#8AABAA"
                    Padding="0"
                    Margin="0,0,5,0"
                    ToolTip.Tip="Suchfilter auswählen">
                <Image Source="avares://FileSearcherApp/GUIAssets/filterIcon.png"
                       Width="20"
                       Height="20"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Nach Name" Tag="FileName" Click="OnFilterMenuItemClick"/>
                        <MenuItem Header="Nach Inhalt" Tag="Content" Click="OnFilterMenuItemClick"/>
                        <MenuItem Header="Nach Beidem" Tag="Both" Click="OnFilterMenuItemClick"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Einstellungsbutton -->
            <Button Grid.Column="2"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="#001816"
                    Foreground="#8AABAA"
                    Padding="0"
                    ToolTip.Tip="Einstellungen">
             <Image Source="avares://FileSearcherApp/GUIAssets/settingsIcon.png"
                  Width="20"
                   Height="20"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Gestalten"/>
                        <MenuItem Header="filler"/>
                        <MenuItem Header="Die Gui ist schuld"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

         <!-- Ergebnisliste -->
        <ListBox Grid.Row="4"
                 x:Name="ResultsList"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Background="#001816"
                 Foreground="#8AABAA"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                </Style>
            </ListBox.Styles>

            <ListBox.DataTemplates>
                <DataTemplate DataType="local:SearchHit">
                    <Border Background="Transparent"
                            HorizontalAlignment="Stretch"
                            Padding="12,9"
                            ToolTip.ShowDelay="400"
                            ToolTip.Placement="Right">

                        <ToolTip.Tip>
                            <StackPanel Spacing="6" MaxWidth="480">
                                <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Path}" Opacity="0.7" TextWrapping="Wrap" FontSize="11"/>
                                <TextBlock Text="{Binding LastWriteText}" Opacity="0.7" FontSize="11"/>
                                <Separator/>
                                <TextBlock Inlines="{Binding Preview, Converter={x:Static local:HighlightConverter.Instance}}"
                                           TextWrapping="Wrap"
                                           MaxHeight="220"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </ToolTip.Tip>

                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>

    </Grid>
</Window>