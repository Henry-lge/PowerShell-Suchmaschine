
<Window MinWidth="650"
        MinHeight="450"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FileSearcherApp.MainWindow"
        Title="Dateisuche über PowerShell"
        Width="650"
        Height="450"
        Icon="avares://FileSearcherApp/GUIAssets/icon.png"
        Background="#0c3835">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Begrüßung -->

            <RowDefinition Height="Auto"/>
            <!-- 1: Suchfeld und Buttons -->

            <RowDefinition Height="Auto"/>
            <!-- 2: Trefferanzeige -->

            <RowDefinition Height="Auto"/>
            <!-- 3: Suchbutton -->

            <RowDefinition Height="*"/>
            <!-- 4: Ergebnisliste -->
        </Grid.RowDefinitions>


        <Grid Grid.Row="0"
      ColumnDefinitions="*,Auto"
      Margin="0,0,0,10">

    <!-- Begrüßung links -->

    <TextBlock Grid.Column="0"
               x:Name="WelcomeText"
               Text="Hallo!"
               Foreground="#8AABAA"
               FontSize="18"
               FontWeight="Bold"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"/>

    <!-- Trefferanzeige rechts -->

    <TextBlock Grid.Column="1"
               x:Name="ResultsCountText"
               Text="Dateien gefunden: 0"
               Foreground="#8AABAA"
               FontSize="18"
               FontWeight="Bold"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"/>

</Grid>


        <!-- SUCHFELD UND BUTTONS -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="10"
              Margin="0,0,0,10">

            <!-- Suchfeld -->

            <Border Grid.Column="0"
                    CornerRadius="8"
                    Height="40"
                    Background="#001816">

                <TextBox x:Name="SearchBox"
                         Text=""
                         Watermark="Suchbegriff eingeben..."
                         Background="#001816"
                         Foreground="#8AABAA"
                         BorderBrush="Transparent"
                         BorderThickness="1"
                         FontSize="16"
                         Margin="4"/>
            </Border>


            <!-- Filterbutton -->
            <Button Grid.Column="1"
        Width="40"
        Height="40"
        CornerRadius="20"
        Background="#001816"
        Foreground="#8AABAA"
        Padding="0"
        ToolTip.Tip="Suchfilter auswählen">

    <!-- Das Icon direkt als Button-Inhalt -->
    <Image Source="avares://FileSearcherApp/GUIAssets/filterIcon.png"
           Width="20"
           Height="20"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"/>

        <Button.Flyout>
            <MenuFlyout>
                <MenuItem Header="Nach Name"
                        Tag="FileName"
                        Click="OnFilterMenuItemClick"/>

                <MenuItem Header="Nach Inhalt"
                        Tag="Content"
                        Click="OnFilterMenuItemClick"/>

                <MenuItem Header="Nach Beidem"
                        Tag="Both"
                        Click="OnFilterMenuItemClick"/>
            </MenuFlyout>
        </Button.Flyout>
    </Button>


            <!-- Einstellungsbutton -->
            <Button Grid.Column="2"
                    Width="40"
                    Height="40"
                    CornerRadius="20"
                    Background="#001816"
                    Foreground="#8AABAA"
                    Padding="0"
                    ToolTip.Tip="Einstellungen">

                <TextBlock Text="⚙"
                           FontSize="25"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>


            <Button.Flyout>
            <MenuFlyout>
                <MenuItem Header="Gestalten"/>

                <MenuItem Header="filler"/>

                <MenuItem Header="Die Gui ist schuld"/>
            </MenuFlyout>
        </Button.Flyout>

            </Button>

        </Grid>

        <!-- ERGEBNISLISTE -->
        <ListBox Grid.Row="4"
                 x:Name="ResultsList"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 Background="#001816"
                 Foreground="#8AABAA"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"/>

    </Grid>

</Window>
